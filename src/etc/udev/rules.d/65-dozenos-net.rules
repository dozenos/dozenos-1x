# These rules use dozenos_net_name to persistently name network interfaces
# per "hwid" association in the DozenOS configuration file.

ACTION!="add", 				GOTO="dozenos_net_end"
SUBSYSTEM!="net",			GOTO="dozenos_net_end"

# Fallback path for Azure VF interfaces: if a VF still appears as plain ethN,
# rename it to vf_ethX before persistent synthetic interface naming runs to
# prevent it from incorrectly being considered as a synthetic interface.
ATTR{[dmi/id]sys_vendor}=="Microsoft Corporation", DRIVERS=="mlx*_core", KERNEL=="eth*", PROGRAM="dozenos_vf_name %k", NAME="%c", GOTO="dozenos_net_end"
ATTR{[dmi/id]sys_vendor}=="Microsoft Corporation", DRIVERS=="mana", KERNEL=="eth*", PROGRAM="dozenos_vf_name %k", NAME="%c", GOTO="dozenos_net_end"

# VF interfaces are not handled by dozenos_net_name, so skip them.
# KERNEL=="vf_*" catches already-renamed Mellanox and MANA VFs.
# DRIVERS=="mlx*_core" and DRIVERS=="mana" on Azure catch VF interfaces
# in an unexpected intermediate state (still named ethN/eN) that must not
# be remapped by dozenos_net_name.
# This guard is intentionally scoped to Microsoft Azure to
# avoid excluding bare-metal Mellanox NICs on physical hardware, which do
# need persistent naming via dozenos_net_name.
KERNEL=="vf_*", 							GOTO="dozenos_net_end"
ATTR{[dmi/id]sys_vendor}=="Microsoft Corporation", DRIVERS=="mlx*_core",	GOTO="dozenos_net_end"
ATTR{[dmi/id]sys_vendor}=="Microsoft Corporation", DRIVERS=="mana",      	GOTO="dozenos_net_end"

# Do name change for ethernet and wireless devices only
KERNEL!="eth*|wlan*|e*", 			GOTO="dozenos_net_end"

# ignore "secondary" monitor interfaces of mac80211 drivers
KERNEL=="wlan*", ATTRS{type}=="803",	GOTO="dozenos_net_end"

# If using DozenOS predefined names
ENV{DOZENOS_IFNAME}!="eth*",	GOTO="end_dozenos_predef_names"

DRIVERS=="?*", PROGRAM="dozenos_net_name %k $attr{address} $env{DOZENOS_IFNAME}", NAME="%c", GOTO="dozenos_net_end"

LABEL="end_dozenos_predef_names"

# ignore interfaces without a driver link like bridges and VLANs
DRIVERS=="?*", PROGRAM="dozenos_net_name %k $attr{address}", NAME="%c"

LABEL="dozenos_net_end"
