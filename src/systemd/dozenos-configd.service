[Unit]
Description=DozenOS configuration daemon

# Without this option, lots of default dependencies are added,
# among them network.target, which creates a dependency cycle
DefaultDependencies=no

# Seemingly sensible way to say "as early as the system is ready"
# All dozenos-configd needs is read/write mounted root
After=systemd-remount-fs.service
Before=dozenos-router.service

[Service]
ExecStart=/usr/bin/python3 -u /usr/libexec/dozenos/services/dozenos-configd
Type=idle

SyslogIdentifier=dozenos-configd
SyslogFacility=daemon

Restart=on-failure

# Does't work in Jessie but leave it here
User=root
Group=vyattacfg

[Install]
WantedBy=dozenos.target
