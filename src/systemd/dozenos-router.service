[Unit]
Description=DozenOS Router
After=systemd-journald-dev-log.socket time-sync.target local-fs.target cloud-config.service
Conflicts=shutdown.target
Before=systemd-user-sessions.service

[Service]
Type=simple
Restart=no
TimeoutSec=20min
KillMode=process
RemainAfterExit=yes
ExecStart=/usr/libexec/dozenos/init/dozenos-router start
ExecStop=/usr/libexec/dozenos/init/dozenos-router stop
StandardOutput=journal+console

[Install]
WantedBy=dozenos.target
