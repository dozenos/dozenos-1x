[Unit]
Description=DozenOS DHCPv4 stuck-RENEW watchdog (oneshot)
Documentation=man:dhclient(8)
After=dozenos-router.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/libexec/dozenos/dozenos-dhclient-lease-watch
SyslogIdentifier=dozenos-dhclient-lease-watch
# Drop the info-level Starting/Finished lines PID 1 logs every 5 minutes;
# the helper only logs at warning and above.
LogLevelMax=notice
Nice=10
