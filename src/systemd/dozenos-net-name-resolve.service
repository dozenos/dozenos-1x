[Unit]
Description=DozenOS persistent interface naming
Documentation=man:dozenos-net-name-resolve.py(8)

# Started by dozenos-router once the config directory is mounted - for an
# encrypted volume that is only after it has been unlocked - so this can not
# be ordered independently. This is the boot pass; hot-plugged hardware is
# named by dozenos-net-name-resolve-hotplug.service, which passes --hotplug.
DefaultDependencies=no

[Service]
Type=oneshot
ExecStart=/usr/libexec/dozenos/system/dozenos-net-name-resolve.py
TimeoutStartSec=90
StandardOutput=journal+console
