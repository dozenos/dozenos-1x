[Unit]
Description=DozenOS deterministic hw-id based interface naming
Documentation=man:dozenos-net-name-resolve.py(8)

# Started explicitly by dozenos-router (like frr.service/dozenos-netlinkd.service)
# once /opt/vyatta/etc/config is mounted and config.boot exists - which, for
# an encrypted config volume, only happens after dozenos-router has unlocked
# and mounted it. It cannot be ordered independently before dozenos-router:
# there is no config.boot to read before that point.
DefaultDependencies=no

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/dozenos/system/dozenos-net-name-resolve.py
TimeoutStartSec=90
StandardOutput=journal+console
