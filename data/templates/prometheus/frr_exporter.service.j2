{% set vrf_command = 'ip vrf exec ' ~ vrf ~ ' runuser -u frr -- ' if vrf is dozenos_defined else '' %}
[Unit]
Description=FRR Exporter
Documentation=https://github.com/tynany/frr_exporter
After=network.target

[Service]
{% if vrf is not dozenos_defined %}
User=frr
{% endif %}
ExecStart={{ vrf_command }}/usr/sbin/frr_exporter \
        --collector.bgp6 \
{% if optional_collectors is dozenos_defined %}
{%     for collector in optional_collectors %}
        --collector.{{ collector }} \
{%     endfor %}
{% endif %}
{% if collector is dozenos_defined %}
{%     if collector.bgp.accept_filtered_prefixes is dozenos_defined %}
        --collector.bgp.accepted-filtered-prefixes \
{%     endif %}
{%     if collector.bgp.advertised_prefixes is dozenos_defined %}
        --collector.bgp.advertised-prefixes \
{%     endif %}
{%     if collector.bgp.peer_description is dozenos_defined %}
        --collector.bgp.peer-descriptions \
{%         if collector.bgp.peer_description is dozenos_defined('plain-text') %}
        --collector.bgp.peer-descriptions.plain-text \
{%         endif %}
{%     endif %}
{%     if collector.bgp.peer_group is dozenos_defined %}
        --collector.bgp.peer-groups \
{%     endif %}
{%     if collector.bgp.peer_hostname is dozenos_defined %}
        --collector.bgp.peer-hostnames \
{%     endif %}
{%     if collector.bgp.peer_type is dozenos_defined %}
        --collector.bgp.peer-types \
{%     endif %}
{%     if collector.ospf_instance is dozenos_defined %}
        --collector.ospf.instances={{ collector.ospf_instance | join(',') }} \
{%     endif %}
{%     if collector.detailed_routes is dozenos_defined %}
        --collector.route.detailed-routes \
{%     endif %}
{% endif %}
{% if listen_address is dozenos_defined %}
{%     for address in listen_address %}
        --web.listen-address={{ address | bracketize_ipv6 }}:{{ port }}
{%     endfor %}
{% else %}
        --web.listen-address=:{{ port }}
{% endif %}
[Install]
WantedBy=multi-user.target
