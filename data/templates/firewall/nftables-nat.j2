#!/usr/sbin/nft -f

{% import 'firewall/nftables-defines.j2' as group_tmpl %}

{% if first_install is not dozenos_defined %}
delete table ip dozenos_nat
{% endif %}
{% if deleted is not dozenos_defined %}
table ip dozenos_nat {
    #
    # Destination NAT rules build up here
    #
    chain PREROUTING {
        type nat hook prerouting priority -100; policy accept;
        counter jump DOZENOS_PRE_DNAT_HOOK
{%     if destination.rule is dozenos_defined %}
{%         for rule, config in destination.rule.items() if config.disable is not dozenos_defined %}
        {{ config | nat_rule(rule, 'destination') }}
{%         endfor %}
{%     endif %}
    }
{%     for set_name in ip_fqdn %}
    set FQDN_nat_{{ set_name }} {
        type ipv4_addr
        flags interval
    }
{%     endfor %}

    #
    # Source NAT rules build up here
    #
    chain POSTROUTING {
        type nat hook postrouting priority 100; policy accept;
        counter jump DOZENOS_PRE_SNAT_HOOK
{%     if source.rule is dozenos_defined %}
{%         for rule, config in source.rule.items() if config.disable is not dozenos_defined %}
        {{ config | nat_rule(rule, 'source') }}
{%         endfor %}
{%     endif %}

    }
{%     for set_name in ip_fqdn %}
    set FQDN_nat_{{ set_name }} {
        type ipv4_addr
        flags interval
    }
{%     endfor %}

    chain DOZENOS_PRE_DNAT_HOOK {
        return
    }

    chain DOZENOS_PRE_SNAT_HOOK {
        return
    }

{{ group_tmpl.groups(firewall_group, False, True) }}
}
{% endif %}
