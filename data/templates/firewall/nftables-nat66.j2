#!/usr/sbin/nft -f

{% import 'firewall/nftables-defines.j2' as group_tmpl %}

{% if first_install is not dozenos_defined %}
delete table ip6 dozenos_nat
{% endif %}
{% if deleted is not dozenos_defined %}
table ip6 dozenos_nat {
    #
    # Destination NAT66 rules build up here
    #
    chain PREROUTING {
        type nat hook prerouting priority -100; policy accept;
        counter jump DOZENOS_DNPT_HOOK
{%     if destination.rule is dozenos_defined %}
{%         for rule, config in destination.rule.items() if config.disable is not dozenos_defined %}
         {{ config | nat_rule(rule, 'destination', ipv6=True) }}
{%         endfor %}
{%     endif %}
    }

    #
    # Source NAT66 rules build up here
    #
    chain POSTROUTING {
        type nat hook postrouting priority 100; policy accept;
        counter jump DOZENOS_SNPT_HOOK
{%     if source.rule is dozenos_defined %}
{%         for rule, config in source.rule.items() if config.disable is not dozenos_defined %}
        {{ config | nat_rule(rule, 'source', ipv6=True) }}
{%         endfor %}
{%     endif %}
    }

    chain DOZENOS_DNPT_HOOK {
        return
    }

    chain DOZENOS_SNPT_HOOK {
        return
    }

{{ group_tmpl.groups(firewall_group, True, True) }}
}
{% endif %}
