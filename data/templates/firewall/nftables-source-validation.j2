{% if strict_handles is dozenos_defined %}
{%     for handle in strict_handles %}
destroy rule {{ family }} raw dozenos_rpfilter handle {{ handle }}
{%     endfor %}
{% endif %}
{% if loose_handles is dozenos_defined %}
{%     for handle in loose_handles %}
destroy rule {{ family }} raw dozenos_rpfilter handle {{ handle }}
{%     endfor %}
{% endif %}

destroy element {{ family }} raw rpfilter_strict_ifaces { "{{ iface }}" }
destroy element {{ family }} raw rpfilter_loose_ifaces { "{{ iface }}" }
destroy element {{ family }} raw rpfilter_strict { "{{ iface }}" }

{% if mode is dozenos_defined('strict') %}
add element {{ family }} raw rpfilter_strict_ifaces { "{{ iface }}" }
add element {{ family }} raw rpfilter_strict { "{{ iface }}" : accept }
{%     if strict_add is dozenos_defined %}
insert rule {{ family }} raw dozenos_rpfilter iifname @rpfilter_strict_ifaces fib saddr . iif oif vmap @rpfilter_strict
{%     endif %}
{% elif mode is dozenos_defined('loose') %}
add element {{ family }} raw rpfilter_loose_ifaces { "{{ iface }}" }
{%     if loose_add is dozenos_defined %}
insert rule {{ family }} raw dozenos_rpfilter iifname @rpfilter_loose_ifaces counter drop
insert rule {{ family }} raw dozenos_rpfilter iifname @rpfilter_loose_ifaces fib saddr oif != 0 counter accept
{%     endif %}
{% endif %}
