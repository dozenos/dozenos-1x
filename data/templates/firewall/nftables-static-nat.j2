#!/usr/sbin/nft -f

{% if first_install is not dozenos_defined %}
delete table ip dozenos_static_nat
{% endif %}
{% if deleted is not dozenos_defined %}
table ip dozenos_static_nat {
    #
    # Destination NAT rules build up here
    #

    chain PREROUTING {
        type nat hook prerouting priority -100; policy accept;
{%     if static.rule is dozenos_defined %}
{%         for rule, config in static.rule.items() if config.disable is not dozenos_defined %}
    {{ config | nat_static_rule(rule, 'destination') }}
{%         endfor %}
{%     endif %}
    }

    #
    # Source NAT rules build up here
    #
    chain POSTROUTING {
        type nat hook postrouting priority 100; policy accept;
{%     if static.rule is dozenos_defined %}
{%         for rule, config in static.rule.items() if config.disable is not dozenos_defined %}
    {{ config | nat_static_rule(rule, 'source') }}
{%         endfor %}
{%     endif %}
    }
}
{% endif %}
