# Generated by ${dozenos_conf_scripts_dir}/service_monitoring_zabbix-agent.py

PidFile=/run/zabbix/zabbix_agent2.pid
LogFile=/var/log/zabbix/zabbix_agent2.log
ControlSocket=/run/zabbix/agent.sock

{% if log is dozenos_defined %}
{%     if log.size is dozenos_defined %}
### Option: LogFileSize
#       Maximum size of log file in MB.
#       0 - disable automatic log rotation.
#
# Range: 0-1024
LogFileSize={{ log.size }}
{%     endif %}
{%     if log.remote_commands is dozenos_defined %}
LogRemoteCommands=1
{%     endif %}
{%     if log.debug_level is dozenos_defined %}
{%         set mapping = {
              'basic': 0,
              'critical': 1,
              'error': 2,
              'warning': 3,
              'debug': 4,
              'extended-debug': 5
           } %}
DebugLevel={{ mapping[log.debug_level] }}
{%     endif %}
{% endif %}

{% if server is dozenos_defined %}
Server={{ server | bracketize_ipv6 | join(',') }}
{% endif %}
{% if server_active is dozenos_defined %}
{%     set servers = [] %}
{%     for key, value in server_active.items() %}
{%         if value.port %}
{%             set serv_item = key | bracketize_ipv6 + ':' + value.port %}
{%             set _ = servers.append(serv_item) %}
{%         else %}
{%             set _ = servers.append(key | bracketize_ipv6) %}
{%         endif %}
{%     endfor %}
ServerActive={{ servers | join(',') }}
{% endif %}

{% if host_name is dozenos_defined %}
Hostname={{ host_name }}
{% endif %}

{% if port is dozenos_defined %}
ListenPort={{ port }}
{% endif %}
{% if listen_address is dozenos_defined %}
ListenIP={{ listen_address | join(',') }}
{% endif %}

{% if limits is dozenos_defined %}
{%     if limits.buffer_flush_interval is dozenos_defined %}
BufferSend={{ limits.buffer_flush_interval }}
{%     endif %}
{%     if limits.buffer_size is dozenos_defined %}
BufferSize={{ limits.buffer_size }}
{%     endif %}
{% endif %}

{% if directory is dozenos_defined %}
### Option: Include
#       You may include individual files or all files in a directory in the configuration file.
Include={{ directory }}/*.conf
{% endif %}

{% if timeout is dozenos_defined %}
Timeout={{ timeout }}
{% endif %}

{% if authentication is dozenos_defined and authentication.mode is dozenos_defined %}
{%     if authentication.mode == "pre-shared-secret" %}
TLSConnect=psk
TLSAccept=psk
{%     endif %}
{%     if authentication.psk.secret is dozenos_defined %}
TLSPSKFile={{ service_psk_file }}
{%     endif %}
{%     if authentication.psk.id is dozenos_defined %}
TLSPSKIdentity={{ authentication.psk.id }}
{%     endif %}
{% endif %}

