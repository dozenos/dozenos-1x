!
{% if interface is dozenos_defined %}
{%     for iface, iface_config in interface.items() %}
interface {{ iface }}
 ip router isis DozenOS
 ipv6 router isis DozenOS
{%         if iface_config.bfd is dozenos_defined %}
 isis bfd
{%             if iface_config.bfd.profile is dozenos_defined %}
 isis bfd profile {{ iface_config.bfd.profile }}
{%             endif %}
{%         endif %}
{%         if iface_config.network.point_to_point is dozenos_defined %}
 isis network point-to-point
{%         endif %}
{%         if iface_config.circuit_type is dozenos_defined %}
 isis circuit-type {{ iface_config.circuit_type }}
{%         endif %}
{%         if iface_config.fast_reroute.lfa is dozenos_defined %}
{%             for level, level_config in iface_config.fast_reroute.lfa.items() %}
{%                 if level_config.enable is dozenos_defined %}
isis fast-reroute lfa {{ level | replace('_', '-') }}
{%                 endif %}
{%                 if level_config.exclude.interface is dozenos_defined %}
{%                     for excl_if in level_config.exclude.interface %}
isis fast-reroute lfa {{ level | replace('_', '-') }} exclude interface {{ excl_if }}
{%                     endfor %}
{%                 endif %}
{%             endfor %}
{%         endif %}
{%         if iface_config.fast_reroute.remote_lfa is dozenos_defined %}
{%             for level, level_config in iface_config.fast_reroute.remote_lfa.items() %}
{%                 if level_config.maximum_metric is dozenos_defined %}
isis fast-reroute remote-lfa maximum-metric {{ level_config.maximum_metric }} {{ level | replace('_', '-') }}
{%                 endif %}
{%                 if level_config.tunnel.mpls_ldp is dozenos_defined %}
isis fast-reroute remote-lfa tunnel mpls-ldp {{ level | replace('_', '-') }}
{%                 endif %}
{%             endfor %}
{%         endif %}
{%         if iface_config.fast_reroute.ti_lfa is dozenos_defined %}
{%             for level, level_config in iface_config.fast_reroute.ti_lfa.items() %}
isis fast-reroute ti-lfa {{ level | replace('_', '-') }} {{ 'node-protection' if level_config.node_protection is dozenos_defined }} {{ 'link-fallback' if level_config.node_protection.link_fallback is dozenos_defined }}
{%             endfor %}
{%         endif %}
{%         if iface_config.hello_interval is dozenos_defined %}
 isis hello-interval {{ iface_config.hello_interval }}
{%         endif %}
{%         if iface_config.hello_multiplier is dozenos_defined %}
 isis hello-multiplier {{ iface_config.hello_multiplier }}
{%         endif %}
{%         if iface_config.hello_padding is dozenos_defined %}
 isis hello padding
{%         endif %}
{%         if iface_config.ldp_sync.disable is dozenos_defined %}
 no isis mpls ldp-sync
{%         elif iface_config.ldp_sync.holddown is dozenos_defined %}
 isis mpls ldp-sync
 isis mpls ldp-sync holddown {{ iface_config.ldp_sync.holddown }}
{%         endif %}
{%         if iface_config.metric is dozenos_defined %}
 isis metric {{ iface_config.metric }}
{%         endif %}
{%         if iface_config.passive is dozenos_defined %}
 isis passive
{%         endif %}
{%         if iface_config.password.md5 is dozenos_defined %}
 isis password md5 {{ iface_config.password.md5 }}
{%         elif iface_config.password.plaintext_password is dozenos_defined %}
 isis password clear {{ iface_config.password.plaintext_password }}
{%         endif %}
{%         if iface_config.priority is dozenos_defined %}
 isis priority {{ iface_config.priority }}
{%         endif %}
{%         if iface_config.psnp_interval is dozenos_defined %}
 isis psnp-interval {{ iface_config.psnp_interval }}
{%         endif %}
{%         if iface_config.no_three_way_handshake is dozenos_defined %}
 no isis three-way-handshake
{%         endif %}
exit
!
{%     endfor %}
{% endif %}
!
router isis DozenOS {{ 'vrf ' + vrf if vrf is dozenos_defined }}
 net {{ net }}
{% if advertise_high_metrics is dozenos_defined %}
advertise-high-metrics
{% endif %}
{% if advertise_passive_only is dozenos_defined %}
advertise-passive-only
{% endif %}
{% if dynamic_hostname is dozenos_defined %}
 hostname dynamic
{% endif %}
{% if purge_originator is dozenos_defined %}
 purge-originator
{% endif %}
{% if set_attached_bit is dozenos_defined %}
 set-attached-bit
{% endif %}
{% if set_overload_bit is dozenos_defined %}
 set-overload-bit
{% endif %}
{% if metric_style is dozenos_defined %}
 metric-style {{ metric_style }}
{% endif %}
{% if domain_password.md5 is dozenos_defined %}
 domain-password md5 {{ domain_password.md5 }}
{% elif domain_password.plaintext_password is dozenos_defined %}
 domain-password clear {{ domain_password.plaintext_password }}
{% endif %}
{% if log_adjacency_changes is dozenos_defined %}
 log-adjacency-changes
{% endif %}
 lsp-timers gen-interval {{ lsp_gen_interval }} refresh-interval {{ lsp_refresh_interval }} max-lifetime {{ max_lsp_lifetime }}
{% if lsp_mtu is dozenos_defined %}
 lsp-mtu {{ lsp_mtu }}
{% endif %}
{% if ldp_sync.holddown is dozenos_defined %}
 mpls ldp-sync holddown {{ ldp_sync.holddown }}
{% elif ldp_sync is dozenos_defined %}
 mpls ldp-sync
{% endif %}
{% if spf_interval is dozenos_defined %}
 spf-interval {{ spf_interval }}
{% endif %}
{% if traffic_engineering.enable is dozenos_defined %}
 mpls-te on
{% endif %}
{% if traffic_engineering.address is dozenos_defined %}
 mpls-te router-address {{ traffic_engineering.address }}
{% endif %}
{% if traffic_engineering.inter_as is dozenos_defined %}
{%     set level = '' %}
{%     if traffic_engineering.inter_as.level_1 is dozenos_defined %}
{%         set level = ' level-1' %}
{%     endif %}
{%     if traffic_engineering.inter_as.level_1_2 is dozenos_defined %}
{%         set level = ' level-1-2' %}
{%     endif %}
{%     if traffic_engineering.inter_as.level_2 is dozenos_defined %}
{%         set level = ' level-2-only' %}
{%     endif %}
 mpls-te inter-as{{ level }}
{% endif %}
{% if traffic_engineering.export is dozenos_defined %}
 mpls-te export
{% endif %}
{% if segment_routing is dozenos_defined %}
{%     if segment_routing.maximum_label_depth is dozenos_defined %}
 segment-routing node-msd {{ segment_routing.maximum_label_depth }}
{%     endif %}
{%     if segment_routing.srv6 is dozenos_defined %}
 segment-routing srv6
{%         if segment_routing.srv6.locator is dozenos_defined %}
  locator {{ segment_routing.srv6.locator }}
{%         endif %}
{%         if segment_routing.srv6.node_msd is dozenos_defined %}
  node-msd
{%             if segment_routing.srv6.node_msd.max_end_d is dozenos_defined %}
   max-end-d {{ segment_routing.srv6.node_msd.max_end_d }}
{%             endif %}
{%             if segment_routing.srv6.node_msd.max_end_pop is dozenos_defined %}
   max-end-pop {{ segment_routing.srv6.node_msd.max_end_pop }}
{%             endif %}
{%             if segment_routing.srv6.node_msd.max_h_encaps is dozenos_defined %}
   max-h-encaps {{ segment_routing.srv6.node_msd.max_h_encaps }}
{%             endif %}
{%             if segment_routing.srv6.node_msd.max_segs_left is dozenos_defined %}
   max-segs-left {{ segment_routing.srv6.node_msd.max_segs_left }}
{%             endif %}
  exit
{%         endif %}
{%         if segment_routing.srv6.interface is dozenos_defined %}
  interface {{ segment_routing.srv6.interface }}
{%         endif %}
 exit
{%     endif %}
{%     if segment_routing.global_block is dozenos_defined %}
{%         if segment_routing.local_block is dozenos_defined %}
 segment-routing global-block {{ segment_routing.global_block.low_label_value }} {{ segment_routing.global_block.high_label_value }} local-block {{ segment_routing.local_block.low_label_value }} {{ segment_routing.local_block.high_label_value }}
{%         else %}
 segment-routing global-block {{ segment_routing.global_block.low_label_value }} {{ segment_routing.global_block.high_label_value }}
{%         endif %}
{%     endif %}
{%     if segment_routing.prefix is dozenos_defined %}
{%         for prefix, prefix_config in segment_routing.prefix.items() %}
{%             if prefix_config.absolute is dozenos_defined %}
{%                 if prefix_config.absolute.value is dozenos_defined %}
 segment-routing prefix {{ prefix }} absolute {{ prefix_config.absolute.value }} {{ 'explicit-null' if prefix_config.absolute.explicit_null is dozenos_defined }} {{ 'no-php-flag' if prefix_config.absolute.no_php_flag is dozenos_defined }}
{%                 endif %}
{%             endif %}
{%             if prefix_config.index is dozenos_defined %}
{%                 if prefix_config.index.value is dozenos_defined %}
 segment-routing prefix {{ prefix }} index {{ prefix_config.index.value }} {{ 'explicit-null' if prefix_config.index.explicit_null is dozenos_defined }} {{ 'no-php-flag' if prefix_config.index.no_php_flag is dozenos_defined }}
{%                 endif %}
{%             endif %}
{%         endfor %}
{%     endif %}
 segment-routing on
{% endif %}
{% if spf_delay_ietf.init_delay is dozenos_defined %}
 spf-delay-ietf init-delay {{ spf_delay_ietf.init_delay }} short-delay {{ spf_delay_ietf.short_delay }} long-delay {{ spf_delay_ietf.long_delay }} holddown {{ spf_delay_ietf.holddown }} time-to-learn {{ spf_delay_ietf.time_to_learn }}
{% endif %}
{% if area_password.md5 is dozenos_defined %}
 area-password md5 {{ area_password.md5 }}
{% elif area_password.plaintext_password is dozenos_defined %}
 area-password clear {{ area_password.plaintext_password }}
{% endif %}
{% if default_information.originate is dozenos_defined %}
{%     for afi, afi_config in default_information.originate.items() %}
{%         for level, level_config in afi_config.items() %}
 default-information originate {{ afi }} {{ level | replace('_', '-') }} {{ 'always' if level_config.always is dozenos_defined }} {{ 'route-map ' ~ level_config.route_map if level_config.route_map is dozenos_defined }} {{ 'metric ' ~ level_config.metric if level_config.metric is dozenos_defined }}
{%         endfor %}
{%     endfor %}
{% endif %}
{% if fast_reroute.lfa is dozenos_defined %}
{%     if fast_reroute.lfa.local is dozenos_defined %}
{%         if fast_reroute.lfa.local.load_sharing.disable.level_1 is dozenos_defined %}
 fast-reroute load-sharing disable level-1
{%         elif fast_reroute.lfa.local.load_sharing.disable.level_2 is dozenos_defined %}
 fast-reroute load-sharing disable level-2
{%         elif fast_reroute.lfa.local.load_sharing.disable is dozenos_defined %}
 fast-reroute load-sharing disable
{%         endif %}
{%         if fast_reroute.lfa.local.priority_limit is dozenos_defined %}
{%             for priority, priority_limit_options in fast_reroute.lfa.local.priority_limit.items() %}
{%                 for level in priority_limit_options %}
 fast-reroute priority-limit {{ priority }} {{ level | replace('_', '-') }}
{%                 endfor %}
{%             endfor %}
{%         endif %}
{%         if fast_reroute.lfa.local.tiebreaker is dozenos_defined %}
{%             for tiebreaker, tiebreaker_options in fast_reroute.lfa.local.tiebreaker.items() %}
{%                 for index, index_options in tiebreaker_options.items() %}
{%                     for index_value, index_value_options in index_options.items() %}
{%                         for level in index_value_options %}
 fast-reroute lfa tiebreaker {{ tiebreaker | replace('_', '-') }} index {{ index_value }} {{ level | replace('_', '-') }}
{%                         endfor %}
{%                     endfor %}
{%                 endfor %}
{%             endfor %}
{%         endif %}
{%     endif %}
{%     if fast_reroute.lfa.remote.prefix_list is dozenos_defined %}
{%         for prefix_list, prefix_list_options in fast_reroute.lfa.remote.prefix_list.items() %}
{%             if prefix_list_options.level_1 is dozenos_defined %}
fast-reroute remote-lfa prefix-list {{ prefix_list }} level-1
{%             endif %}
{%             if prefix_list_options.level_2 is dozenos_defined %}
fast-reroute remote-lfa prefix-list {{ prefix_list }} level-2
{%             endif %}
{%             if prefix_list is dozenos_defined and prefix_list_options.level_1 is not dozenos_defined and prefix_list_options.level_2 is not dozenos_defined %}
fast-reroute remote-lfa prefix-list {{ prefix_list }}
{%             endif %}
{%         endfor %}
{%     endif %}
{% endif %}
{% if redistribute.ipv4 is dozenos_defined %}
{%     for protocol, protocol_options in redistribute.ipv4.items() %}
{%         for level, level_config in protocol_options.items() %}
{%             if level_config.metric is dozenos_defined %}
 redistribute ipv4 {{ protocol }} {{ level | replace('_', '-') }} metric {{ level_config.metric }}
{%             elif level_config.route_map is dozenos_defined %}
 redistribute ipv4 {{ protocol }} {{ level | replace('_', '-') }} route-map {{ level_config.route_map }}
{%             else %}
 redistribute ipv4 {{ protocol }} {{ level | replace('_', '-') }}
{%             endif %}
{%         endfor %}
{%     endfor %}
{% endif %}
{% if redistribute.ipv6 is dozenos_defined %}
{%     for protocol, protocol_options in redistribute.ipv6.items() %}
{%         for level, level_config in protocol_options.items() %}
{%             if level_config.metric is dozenos_defined %}
 redistribute ipv6 {{ protocol }} {{ level | replace('_', '-') }} metric {{ level_config.metric }}
{%             elif level_config.route_map is dozenos_defined %}
 redistribute ipv6 {{ protocol }} {{ level | replace('_', '-') }} route-map {{ level_config.route_map }}
{%             else %}
 redistribute ipv6 {{ protocol }} {{ level | replace('_', '-') }}
{%             endif %}
{%         endfor %}
{%     endfor %}
{% endif %}
{% if topology is dozenos_defined %}
topology {{ topology }}
{% endif %}
{% if level is dozenos_defined('level-2') %}
 is-type level-2-only
{% elif level is dozenos_defined %}
 is-type {{ level }}
{% endif %}
exit
!
