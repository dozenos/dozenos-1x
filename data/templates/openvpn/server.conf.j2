### Autogenerated by interfaces_openvpn.py ###
#
# See https://community.openvpn.net/openvpn/wiki/Openvpn24ManPage
# for individual keyword definition
#
# {{ description if description is dozenos_defined }}
#

verb 3
dev-type {{ device_type }}
dev {{ ifname }}
persist-key
{% if protocol is dozenos_defined('tcp-active') %}
proto tcp{{ protocol_modifier }}-client
{% elif protocol is dozenos_defined('tcp-passive') %}
proto tcp{{ protocol_modifier }}-server
{% else %}
proto udp{{ protocol_modifier }}
{% endif %}
{% if local_host is dozenos_defined %}
local {{ local_host }}
{% endif %}
{% if mode is dozenos_defined('server') and protocol is dozenos_defined('udp') and local_host is not dozenos_defined %}
multihome
{% endif %}
{% if local_port is dozenos_defined %}
lport {{ local_port }}
{% endif %}
{% if remote_port is dozenos_defined %}
rport {{ remote_port }}
{% endif %}
{% if remote_host is dozenos_defined %}
{%     for remote in remote_host %}
remote {{ remote }}
{%     endfor %}
{% endif %}
{% if shared_secret_key is dozenos_defined %}
secret /run/openvpn/{{ ifname }}_shared.key
{% endif %}
{% if persistent_tunnel is dozenos_defined %}
persist-tun
{% endif %}
{% if replace_default_route.local is dozenos_defined %}
push "redirect-gateway local def1"
{% elif replace_default_route is dozenos_defined %}
push "redirect-gateway def1"
{% endif %}
{% if use_lzo_compression is dozenos_defined %}
compress lzo
{% endif %}
{% if offload.dco is not dozenos_defined %}
disable-dco
{% endif %}

{% if mode is dozenos_defined('client') %}
#
# OpenVPN Client mode
#
client
nobind

{% elif mode is dozenos_defined('server') %}
#
# OpenVPN Server mode
#
{%     if ip_version is dozenos_defined('ipv6') %}
bind ipv6only
{%     endif %}
mode server
tls-server
{%     if server is dozenos_defined %}
{%         if server.subnet is dozenos_defined %}
{%             if server.topology is dozenos_defined('point-to-point') %}
topology p2p
{%             elif server.topology is dozenos_defined %}
topology {{ server.topology }}
{%             endif %}
{%             for subnet in server.subnet %}
{%                 if subnet | is_ipv4 %}
server {{ subnet | address_from_cidr }} {{ subnet | netmask_from_cidr }} {{ 'nopool' if server.client_ip_pool is dozenos_defined and server.client_ip_pool.disable is not dozenos_defined else '' }}
{# First ip address is used as gateway. It's allows to use metrics #}
{%                     if server.push_route is dozenos_defined %}
{%                         for route, route_config in server.push_route.items() %}
{%                             if route | is_ipv4 %}
push "route {{ route | address_from_cidr }} {{ route | netmask_from_cidr }} {{ 'vpn_gateway' ~ ' ' ~ route_config.metric if route_config.metric is dozenos_defined }}"
{%                             elif route | is_ipv6 %}
push "route-ipv6 {{ route }}"
{%                             endif %}
{%                         endfor %}
{%                     endif %}
{%                 elif subnet | is_ipv6 %}
server-ipv6 {{ subnet }}
{%                 endif %}
{%             endfor %}
{%         endif %}
{%         if server.bridge is dozenos_defined and server.bridge.disable is not dozenos_defined %}
server-bridge {{ server.bridge.gateway }} {{ server.bridge.subnet_mask }} {{ server.bridge.start }} {{ server.bridge.stop if server.bridge.stop is dozenos_defined }}
{%         endif %}
{%         if server.client_ip_pool is dozenos_defined and server.client_ip_pool.disable is not dozenos_defined %}
ifconfig-pool {{ server.client_ip_pool.start }} {{ server.client_ip_pool.stop }} {{ server.client_ip_pool.subnet_mask if server.client_ip_pool.subnet_mask is dozenos_defined }}
{%         endif %}
{%         if server.max_connections is dozenos_defined %}
max-clients {{ server.max_connections }}
{%         endif %}
{%         if server.client is dozenos_defined or server.reject_unconfigured_clients is dozenos_defined %}
client-config-dir /run/openvpn/ccd/{{ ifname }}
{%         endif %}
{%     endif %}
keepalive {{ keep_alive.interval }} {{ keep_alive.interval | int * keep_alive.failure_count | int }}
management /run/openvpn/openvpn-mgmt-intf unix
{%     if server is dozenos_defined %}
{%         if server.reject_unconfigured_clients is dozenos_defined %}
ccd-exclusive
{%         endif %}

{%         if server.name_server is dozenos_defined %}
{%             for nameserver in server.name_server %}
{%                 if nameserver | is_ipv4 %}
push "dhcp-option DNS {{ nameserver }}"
{%                 elif nameserver | is_ipv6 %}
push "dhcp-option DNS6 {{ nameserver }}"
{%                 endif %}
{%             endfor %}
{%         endif %}
{%         if server.domain_name is dozenos_defined %}
push "dhcp-option DOMAIN {{ server.domain_name }}"
{%         endif %}
{%         if server.mfa.totp is dozenos_defined %}
{%             set totp_config = server.mfa.totp %}
plugin "{{ plugin_dir }}/openvpn-otp.so" "otp_secrets=/config/auth/openvpn/{{ ifname }}-otp-secrets otp_slop={{ totp_config.slop }} totp_t0={{ totp_config.drift }} totp_step={{ totp_config.step }} totp_digits={{ totp_config.digits }} password_is_cr={{ '1' if totp_config.challenge == 'enable' else '0' }}"
{%         endif %}
{%     endif %}
{% else %}
#
# OpenVPN site-2-site mode
#
{%     if ip_version is dozenos_defined('ipv6') %}
bind ipv6only
{%     endif %}
ping {{ keep_alive.interval }}
ping-restart {{ keep_alive.failure_count }}

{%     if device_type == 'tap' %}
{%         if local_address is dozenos_defined %}
{%             for laddr, laddr_conf in local_address.items() if laddr | is_ipv4 %}
{%                 if laddr_conf.subnet_mask is dozenos_defined %}
ifconfig {{ laddr }} {{ laddr_conf.subnet_mask }}
{%                 endif %}
{%             endfor %}
{%         endif %}
{%     else %}
{%         for laddr in local_address if laddr | is_ipv4 %}
{%             for raddr in remote_address if raddr | is_ipv4 %}
ifconfig {{ laddr }} {{ raddr }}
{%             endfor %}
{%         endfor %}
{%         for laddr in local_address if laddr | is_ipv6 %}
{%             for raddr in remote_address if raddr | is_ipv6 %}
ifconfig-ipv6 {{ laddr }} {{ raddr }}
{%             endfor %}
{%         endfor %}
{%     endif %}
{% endif %}

{% if tls is dozenos_defined %}
# TLS options
{%     if tls.ca_certificate is dozenos_defined %}
ca /run/openvpn/{{ ifname }}_ca.pem
{%     endif %}
{%     if tls.certificate is dozenos_defined %}
cert /run/openvpn/{{ ifname }}_cert.pem
{%     endif %}
{%     if tls.private_key is dozenos_defined %}
key /run/openvpn/{{ ifname }}_cert.key
{%     endif %}
{%     if tls.crypt_key is dozenos_defined %}
tls-crypt /run/openvpn/{{ ifname }}_crypt.key
{%     endif %}
{%     if tls.crl is dozenos_defined %}
crl-verify /run/openvpn/{{ ifname }}_crl.pem
{%     endif %}
{%     if tls.tls_version_min is dozenos_defined %}
tls-version-min {{ tls.tls_version_min }}
{%     endif %}
{%     if tls.dh_params is dozenos_defined %}
dh /run/openvpn/{{ ifname }}_dh.pem
{%     else %}
dh none
{%     endif %}
{%     if tls.auth_key is dozenos_defined %}
{%         if mode == 'client' %}
tls-auth /run/openvpn/{{ ifname }}_auth.key 1
{%         elif mode == 'server' %}
tls-auth /run/openvpn/{{ ifname }}_auth.key 0
{%         endif %}
{%     endif %}
{%     if tls.role is dozenos_defined('active') %}
tls-client
{%     elif tls.role is dozenos_defined('passive') %}
tls-server
{%     endif %}

{%     if tls.peer_fingerprint is dozenos_defined %}
<peer-fingerprint>
{%         for fp in tls.peer_fingerprint %}
{{ fp }}
{%         endfor %}
</peer-fingerprint>
{%     endif %}
{% endif %}

# Encryption options
{% if encryption is dozenos_defined %}
{%     if encryption.cipher is dozenos_defined %}
cipher {{ encryption.cipher | openvpn_cipher }}
{%     endif %}
{%     if encryption.data_ciphers is dozenos_defined %}
data-ciphers {{ encryption.data_ciphers | openvpn_data_ciphers }}
{%     endif %}
{%     if encryption.data_ciphers_fallback is dozenos_defined %}
data-ciphers-fallback {{ encryption.data_ciphers_fallback | openvpn_data_ciphers_fallback }}
{%     endif %}
{% endif %}
providers default

{% if hash is dozenos_defined %}
auth {{ hash }}
{% endif %}

{% if authentication is dozenos_defined %}
auth-user-pass {{ auth_user_pass_file }}
auth-retry nointeract
{% endif %}
