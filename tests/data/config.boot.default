system {
    host-name dozenos
    login {
        user dozenos {
            authentication {
                encrypted-password $6$YiLdwiqE0PRuD0Q.$ONlgq2rKNcUtHCsoLL1D8VJ5ouwWJJWeEAPd/Hngl5iE.clqYCYrVvp0F5xORp6Wo1YTqhb8UbNfaZdRUy9/a0
                plaintext-password ""
            }
            level admin
        }
    }
    syslog {
        global {
            facility all {
                level notice
            }
            facility protocols {
                level debug
            }
        }
    }
    ntp {
        server "0.pool.ntp.org"
        server "1.pool.ntp.org"
        server "2.pool.ntp.org"
    }
    console {
        device ttyS0 {
            speed 9600
        }
    }
    config-management {
        commit-revisions 100
    }
}

interfaces {
    loopback lo {
    }
}
