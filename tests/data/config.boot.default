system {
    host-name dozenos
    login {
        user dozenos {
            authentication {
                encrypted-password $6$snaR4p2QLNiumvkl$Neh8pXd/BtYBoYUNo.Q4Lr9NpaL9CRh92a6HhFpCZ5ln3nvZHEElkLEe.AH2UVEko7e7JvS..kI8IDRKd56Lt1
                plaintext-password ""
            }
            level admin
        }
    }
    syslog {
        global {
            facility all {
                level notice
            }
            facility protocols {
                level debug
            }
        }
    }
    ntp {
        server "0.pool.ntp.org"
        server "1.pool.ntp.org"
        server "2.pool.ntp.org"
    }
    console {
        device ttyS0 {
            speed 9600
        }
    }
    config-management {
        commit-revisions 100
    }
}

interfaces {
    loopback lo {
    }
}
