system {
    host-name dozenos
    login {
        user dozenos {
            authentication {
                encrypted-password $6$p5Efu/2e2g8D2hJV$2jJojvJpg/NJ1ytL9Q73zsG./pdfrtJS5WU6R3VQzx0.HAucjiKixguM/DVtamnXnp0Al8bFdL7SrWQ84G1cN0
                plaintext-password ""
            }
            level admin
        }
    }
    syslog {
        global {
            facility all {
                level notice
            }
            facility protocols {
                level debug
            }
        }
    }
    ntp {
        server "0.pool.ntp.org"
        server "1.pool.ntp.org"
        server "2.pool.ntp.org"
    }
    console {
        device ttyS0 {
            speed 9600
        }
    }
    config-management {
        commit-revisions 100
    }
}

interfaces {
    loopback lo {
    }
}
