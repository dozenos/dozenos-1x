system {
    host-name dozenos
    login {
        user dozenos {
            authentication {
                encrypted-password $6$NfJ1k88mNBeNT/s5$buA/YH21b7raV6mUonph9jiPr4TqUujp0sRQvMm2d5SDF7py2O0EqxN2QL0.797xu7egKJjoZq0EtkDuhXd5c0
                plaintext-password ""
            }
            level admin
        }
    }
    syslog {
        global {
            facility all {
                level notice
            }
            facility protocols {
                level debug
            }
        }
    }
    ntp {
        server "0.pool.ntp.org"
        server "1.pool.ntp.org"
        server "2.pool.ntp.org"
    }
    console {
        device ttyS0 {
            speed 9600
        }
    }
    config-management {
        commit-revisions 100
    }
}

interfaces {
    loopback lo {
    }
}
