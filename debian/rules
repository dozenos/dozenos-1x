#!/usr/bin/make -f

DIR := debian/tmp
DIR_AWS := $(DIR)/dozenos-1x-aws
DIR_LIBDOZENOSCONFIG := $(DIR)/libdozenosconfig
DOZENOS_SBIN_DIR := usr/sbin
DOZENOS_BIN_DIR := usr/bin
DOZENOS_LIB_DIR := usr/lib
DOZENOS_LIBEXEC_DIR := usr/libexec/dozenos
DOZENOS_DATA_DIR := usr/share/dozenos
DOZENOS_CFG_TMPL_DIR := opt/vyatta/share/vyatta-cfg/templates
DOZENOS_OP_TMPL_DIR := opt/vyatta/share/vyatta-op/templates
DOZENOS_MIBS_DIR := usr/share/snmp/mibs
DOZENOS_LOCALUI_DIR := srv/localui

VYCONF := usr/libexec/dozenos/vyconf
VYCONF_BIN := $(VYCONF)/bin
VYCONF_CONF := $(VYCONF)/config
VYCONF_SESSION := $(VYCONF)/session
VYCONF_DATA := usr/share/dozenos/vyconf
VYCONF_DEF := etc/dozenos
VYCONF_REFTREE_DIR := $(DOZENOS_LIBEXEC_DIR)/vyconf/reftree

OCAML_DIR := /opt/opam/${OCAML_VERSION}
DOZENOS_OCAML_TOOLS := src/ocaml/_build/install/default/bin

MIGRATION_SCRIPTS_DIR := opt/vyatta/etc/config-migrate/migrate
ACTIVATION_SCRIPTS_DIR := usr/libexec/dozenos/activate
SYSTEM_SCRIPTS_DIR := usr/libexec/dozenos/system
SERVICES_DIR := usr/libexec/dozenos/services

DEB_TARGET_ARCH := $(shell dpkg-architecture -qDEB_TARGET_ARCH)

# Base version prefix from debian/changelog
BASE_VERSION := 999.0
COMMIT_ID := $(shell echo -n g && git rev-parse --short HEAD)
COMMIT_COUNT := $(shell git rev-list HEAD --count)
DIRTY_FLAG := $(shell ! git diff --quiet || ! git diff --cached --quiet && echo -dirty || echo)

%:
	dh $@ --with python3, --with quilt

# Skip dh_strip_nondeterminism - this is very time consuming
# and we have no non deterministic output (yet)
override_dh_strip_nondeterminism:

override_dh_gencontrol:
	dh_gencontrol -- -v$(BASE_VERSION)-$(COMMIT_COUNT)-$(COMMIT_ID)$(DIRTY_FLAG)

override_dh_auto_build:
	make all

override_dh_auto_install:
	dh_auto_install

	cd python; python3 setup.py install --install-layout=deb --root ../$(DIR); cd ..

	# Remove all __pycache__ directories before installing
	find . -type d -name '__pycache__' -exec rm -rf {} +

	# Install scripts
	mkdir -p $(DIR)/$(DOZENOS_SBIN_DIR)
	mkdir -p $(DIR)/$(DOZENOS_BIN_DIR)
	cp -r src/utils/* $(DIR)/$(DOZENOS_BIN_DIR)
	cp src/shim/vyshim $(DIR)/$(DOZENOS_SBIN_DIR)

	# Install conf mode scripts
	mkdir -p $(DIR)/$(DOZENOS_LIBEXEC_DIR)/conf_mode
	cp -r src/conf_mode/* $(DIR)/$(DOZENOS_LIBEXEC_DIR)/conf_mode

	# Install op mode scripts
	mkdir -p $(DIR)/$(DOZENOS_LIBEXEC_DIR)/op_mode
	cp -r src/op_mode/* $(DIR)/$(DOZENOS_LIBEXEC_DIR)/op_mode

	# Install op mode scripts
	mkdir -p $(DIR)/$(DOZENOS_LIBEXEC_DIR)/init
	cp -r src/init/* $(DIR)/$(DOZENOS_LIBEXEC_DIR)/init

	# Install validators
	mkdir -p $(DIR)/$(DOZENOS_LIBEXEC_DIR)/validators
	cp -r src/validators/* $(DIR)/$(DOZENOS_LIBEXEC_DIR)/validators

	# Install completion helpers
	mkdir -p $(DIR)/$(DOZENOS_LIBEXEC_DIR)/completion
	cp -r src/completion/* $(DIR)/$(DOZENOS_LIBEXEC_DIR)/completion

	# Install helper scripts
	cp -r src/helpers/* $(DIR)/$(DOZENOS_LIBEXEC_DIR)/

	# Install migration scripts
	mkdir -p $(DIR)/$(MIGRATION_SCRIPTS_DIR)
	cp -r src/migration-scripts/* $(DIR)/$(MIGRATION_SCRIPTS_DIR)

	# Install activation scripts
	mkdir -p $(DIR)/$(ACTIVATION_SCRIPTS_DIR)
	cp -r src/activation-scripts/* $(DIR)/$(ACTIVATION_SCRIPTS_DIR)

	# Install system scripts
	mkdir -p $(DIR)/$(SYSTEM_SCRIPTS_DIR)
	cp -r src/system/* $(DIR)/$(SYSTEM_SCRIPTS_DIR)

	# Install system services
	mkdir -p $(DIR)/$(SERVICES_DIR)
	cp -r src/services/* $(DIR)/$(SERVICES_DIR)

	# Install configuration command definitions
	mkdir -p $(DIR)/$(DOZENOS_CFG_TMPL_DIR)
	cp -r templates-cfg/* $(DIR)/$(DOZENOS_CFG_TMPL_DIR)

	# Install operational command definitions
	mkdir -p $(DIR)/$(DOZENOS_OP_TMPL_DIR)
	cp -r templates-op/* $(DIR)/$(DOZENOS_OP_TMPL_DIR)

	# Install data files
	mkdir -p $(DIR)/$(VYCONF_REFTREE_DIR)
	cp -r data/reftree.cache $(DIR)/$(VYCONF_REFTREE_DIR)
	mkdir -p $(DIR)/$(DOZENOS_DATA_DIR)
	cp -r data/* $(DIR)/$(DOZENOS_DATA_DIR)
	# Remove j2lint comments / linter configuration which would insert additional new-lines
	find $(DIR)/$(DOZENOS_DATA_DIR) -name "*.j2" -type f | xargs sed -i -e '/^{#.*#}/d'

	# Create localui dir
	mkdir -p $(DIR)/$(DOZENOS_LOCALUI_DIR)

	# Install SNMP MIBs
	mkdir -p $(DIR)/$(DOZENOS_MIBS_DIR)
	cp -d mibs/* $(DIR)/$(DOZENOS_MIBS_DIR)

	# Install etc configuration files
	mkdir -p $(DIR)/etc
	cp -r src/etc/* $(DIR)/etc

	# Install legacy Vyatta files
	mkdir -p $(DIR)/opt
	cp -r src/opt/* $(DIR)/opt

	# Install PAM configuration snippets
	mkdir -p $(DIR)/usr/share/pam-configs
	cp -r src/pam-configs/* $(DIR)/usr/share/pam-configs

	# Install systemd service units
	mkdir -p $(DIR)/lib/systemd/system
	cp -r src/systemd/* $(DIR)/lib/systemd/system

	# Make directory for generated configuration file
	mkdir -p $(DIR)/etc/dozenos

	# Install smoke test scripts
	mkdir -p $(DIR)/$(DOZENOS_LIBEXEC_DIR)/tests/smoke/
	cp -r smoketest/scripts/* $(DIR)/$(DOZENOS_LIBEXEC_DIR)/tests/smoke

	# Install smoke test configs
	mkdir -p $(DIR)/$(DOZENOS_LIBEXEC_DIR)/tests/configs/
	cp -r smoketest/configs/* $(DIR)/$(DOZENOS_LIBEXEC_DIR)/tests/configs

	# Install system programs
	mkdir -p $(DIR)/$(DOZENOS_BIN_DIR)
	cp -r smoketest/bin/* $(DIR)/$(DOZENOS_BIN_DIR)

	# Install udev scripts
	mkdir -p $(DIR)/usr/lib/udev
	cp -r src/udev/* $(DIR)/usr/lib/udev

	# dozenos-1x-aws package
	# Move some files to dedicated DEB packages
	#
	mkdir -p $(DIR_AWS)/lib/systemd/system
	mv $(DIR)/lib/systemd/system/aws-gwlbtun.service $(DIR_AWS)/lib/systemd/system

	mkdir -p $(DIR_AWS)/opt/vyatta/share/vyatta-cfg/templates/service
	mv $(DIR)/opt/vyatta/share/vyatta-cfg/templates/service/aws $(DIR_AWS)/opt/vyatta/share/vyatta-cfg/templates/service

	mkdir -p $(DIR_AWS)/usr/libexec/dozenos/conf_mode
	mv $(DIR)/usr/libexec/dozenos/conf_mode/service_aws_glb.py $(DIR_AWS)/usr/libexec/dozenos/conf_mode

	mkdir -p $(DIR_AWS)/usr/share/dozenos/templates
	mv $(DIR)/usr/share/dozenos/templates/aws/ $(DIR_AWS)/usr/share/dozenos/templates

	# libdozenosconfig package
	mkdir -p $(DIR_LIBDOZENOSCONFIG)/$(DOZENOS_LIB_DIR)
	mkdir -p $(DIR_LIBDOZENOSCONFIG)/$(VYCONF_CONF)
	mkdir -p $(DIR_LIBDOZENOSCONFIG)/$(VYCONF_SESSION)
	mkdir -p $(DIR_LIBDOZENOSCONFIG)/$(VYCONF_DATA)
	mkdir -p $(DIR_LIBDOZENOSCONFIG)/$(VYCONF_DEF)
	mkdir -p $(DIR_LIBDOZENOSCONFIG)/$(VYCONF_BIN)

	cp $(OCAML_DIR)/share/vyconf/vyconf.proto $(DIR_LIBDOZENOSCONFIG)/$(VYCONF_DATA)
	cp $(OCAML_DIR)/share/vyconf/vyconfd.conf $(DIR_LIBDOZENOSCONFIG)/$(VYCONF_DEF)
	cp $(OCAML_DIR)/bin/vyconfd $(DIR_LIBDOZENOSCONFIG)/$(VYCONF)
	cp $(OCAML_DIR)/bin/vyconf_cli $(DIR_LIBDOZENOSCONFIG)/$(VYCONF)
	cp $(OCAML_DIR)/bin/vyconf_cli_compat $(DIR_LIBDOZENOSCONFIG)/$(VYCONF_BIN)
	cp libdozenosconfig/_build/libdozenosconfig.so $(DIR_LIBDOZENOSCONFIG)/$(DOZENOS_LIB_DIR)/libdozenosconfig.so.0

	# OCaml binaries from former dozenos-utils package
	cp $(DOZENOS_OCAML_TOOLS)/numeric $(DIR)/$(DOZENOS_LIBEXEC_DIR)/validators
	cp $(DOZENOS_OCAML_TOOLS)/validate-value $(DIR)/$(DOZENOS_LIBEXEC_DIR)
	cp $(DOZENOS_OCAML_TOOLS)/file-path $(DIR)/$(DOZENOS_LIBEXEC_DIR)/validators
	cp $(DOZENOS_OCAML_TOOLS)/url $(DIR)/$(DOZENOS_LIBEXEC_DIR)/validators
	cp $(DOZENOS_OCAML_TOOLS)/list_interfaces $(DIR)/$(DOZENOS_LIBEXEC_DIR)/completion
	cp $(DOZENOS_OCAML_TOOLS)/dozenos-op-run $(DIR)/$(DOZENOS_BIN_DIR)

override_dh_installsystemd:
	dh_installsystemd -pdozenos-1x --name dozenos-router dozenos-router.service
	dh_installsystemd -pdozenos-1x --name dozenos dozenos.target
